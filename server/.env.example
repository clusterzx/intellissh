# Server Configuration
NODE_ENV=development
PORT=3000

# Database
# Database
# DB_TYPE=sqlite (default) or postgres
DB_TYPE=sqlite
DB_PATH=./data/webssh.db

# PostgreSQL Configuration (only used if DB_TYPE=postgres)
# DATABASE_URL=postgresql://user:password@host:port/database
# OR individual parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=webssh

# Authentication
JWT_SECRET=your_jwt_secret_here_please_change_in_production
JWT_EXPIRES_IN=24h

# Encryption
ENCRYPTION_KEY=736f4149702aae82ab6e45e64d977e3c6c1e9f7b29b368f61cafab1b9c2cc3b2

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# LLM Helper Configuration
LLM_PROVIDER=openai  # openai or ollama
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2
